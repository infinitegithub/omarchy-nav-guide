#!/bin/bash
# Query active window and all open clients for nav-guide plugin
set -eo pipefail

WINDOWS_FILE="$HOME/.local/state/omarchy/nav-guide-windows.json"
mkdir -p "$(dirname "$WINDOWS_FILE")"

active=$(hyprctl activewindow -j 2>/dev/null || echo '{}')
clients=$(hyprctl clients -j 2>/dev/null || echo '[]')

out=$(jq -n --argjson a "$active" --argjson c "$clients" '{active: $a, clients: $c}')
echo "$out" > "$WINDOWS_FILE.tmp" && mv "$WINDOWS_FILE.tmp" "$WINDOWS_FILE"
echo "$out"
