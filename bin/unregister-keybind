#!/bin/bash
# Remove Navigation Guide keybinding from ~/.config/hypr/bindings.lua
set -euo pipefail

BINDINGS_FILE="${HOME}/.config/hypr/bindings.lua"
START_MARKER="-- [nav-guide-keybind]"
LOCK_FILE="${HOME}/.local/state/omarchy/nav-guide-listener.lock"

if [[ -f "$BINDINGS_FILE" ]] && grep -q -F -e "$START_MARKER" "$BINDINGS_FILE"; then
  # Remove lines from START_MARKER to [/nav-guide-keybind]
  sed -i '/-- \[nav-guide-keybind\]/,/-- \[\/nav-guide-keybind\]/d' "$BINDINGS_FILE"
  hyprctl reload >/dev/null 2>&1 || true

  # Terminate background socket listener if active
  if [[ -f "$LOCK_FILE" ]]; then
    # Read only the first line (PID) from the lock file
    PID=$(head -n1 "$LOCK_FILE" 2>/dev/null | tr -d '[:space:]' || echo "")
    if [[ -n "$PID" ]] && [[ "$PID" =~ ^[0-9]+$ ]]; then
      # Verify the PID belongs to our listener before signaling —
      # prevents accidental termination of an unrelated process that
      # happens to reuse the same PID.
      PROC_CMD=$(tr '\0' ' ' < "/proc/${PID}/cmdline" 2>/dev/null || echo "")
      if [[ "$PROC_CMD" == *"hypr-listener"* ]] && kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
      fi
    fi
    rm -f "$LOCK_FILE" 2>/dev/null || true
  fi
  # Note: broad pkill -f fallback intentionally removed — it is unsafe
  # because it can match and terminate unrelated processes.

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g "󰞋" "Navigation Guide keybindings restored to defaults" || true
  fi
fi
