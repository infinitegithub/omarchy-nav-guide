#!/bin/bash
# Remove Navigation Guide keybinding from ~/.config/hypr/bindings.lua
set -euo pipefail

BINDINGS_FILE="${HOME}/.config/hypr/bindings.lua"
START_MARKER="-- [nav-guide-keybind]"
LOCK_FILE="${HOME}/.local/state/omarchy/nav-guide-listener.lock"

if [[ -f "$BINDINGS_FILE" ]] && grep -q -F -e "$START_MARKER" "$BINDINGS_FILE"; then
  # Remove lines from START_MARKER to [/nav-guide-keybind]
  sed -i '/-- \[nav-guide-keybind\]/,/-- \[\/nav-guide-keybind\]/d' "$BINDINGS_FILE"
  hyprctl reload >/dev/null 2>&1 || true

  # Terminate background socket listener if active.
  # All identity checks are performed inline by python3 to avoid TOCTOU
  # races and to keep O_NOFOLLOW semantics available in bash context.
  python3 - "$LOCK_FILE" <<'PYEOF'
import sys, os, stat, fcntl, signal

lock_path = sys.argv[1]

# --- 1. Open without following symlinks ---
try:
    fd = os.open(lock_path, os.O_RDONLY | os.O_NOFOLLOW)
except OSError as e:
    # Symlink or unreadable — do not signal anything
    sys.exit(0)

try:
    # --- 2. Verify it is a regular file owned by the current user ---
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        sys.exit(0)
    if st.st_uid != os.getuid():
        sys.exit(0)

    content = os.read(fd, 256).decode("utf-8", "ignore").splitlines()
finally:
    os.close(fd)

if len(content) < 2:
    sys.exit(0)

# --- 3. Parse PID and stored start time ---
pid_str   = content[0].strip()
stored_st = content[1].strip()

if not pid_str.isdigit():
    sys.exit(0)
pid = int(pid_str)

# --- 4. Verify exact script identity: /proc/PID/exe must resolve to hypr-listener ---
try:
    exe = os.readlink(f"/proc/{pid}/exe")
except OSError:
    sys.exit(0)
if "hypr-listener" not in exe:
    sys.exit(0)

# --- 5. Compare stored start time to live /proc/PID/stat field 22 ---
try:
    with open(f"/proc/{pid}/stat", "r") as sf:
        fields = sf.read().split()
    live_st = fields[21]
except (OSError, IndexError):
    sys.exit(0)

if live_st != stored_st:
    # PID was reused — stored start time does not match
    sys.exit(0)

# --- 6. All checks passed — safe to signal ---
try:
    os.kill(pid, signal.SIGTERM)
except ProcessLookupError:
    pass
PYEOF
  rm -f "$LOCK_FILE" 2>/dev/null || true

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g "󰞋" "Navigation Guide keybindings restored to defaults" || true
  fi
fi
