#!/usr/bin/env python3
"""
Hyprland socket2 real-time event listener for Navigation Guide (nav-guide).
1. Detects native keyboard window actions and logs them to the stats manager.
2. Continuously updates ~/.local/state/omarchy/nav-guide-windows.json with live active window
   and all open clients so Quickshell's FileView has instantaneous 0ms access to real open apps.
"""
import sys
import os
import socket
import time
import json
import fcntl
import subprocess

# Add plugin bin directory to sys.path to import stats_manager logic
BIN_DIR = os.path.dirname(os.path.abspath(__file__))
if BIN_DIR not in sys.path:
    sys.path.insert(0, BIN_DIR)

from stats_manager import record_action

LOCK_FILE = os.path.expanduser("~/.local/state/omarchy/nav-guide-listener.lock")
WINDOWS_FILE = os.path.expanduser("~/.local/state/omarchy/nav-guide-windows.json")
KEYBINDINGS_FILE = os.path.expanduser("~/.local/state/omarchy/nav-guide-keybindings.json")

def acquire_lock():
    os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
    f = open(LOCK_FILE, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        f.write(str(os.getpid()))
        f.flush()
        return f
    except IOError:
        # Another listener instance is already running
        sys.exit(0)

def get_socket_path():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    uid = os.getuid()
    if sig:
        candidate = f"/run/user/{uid}/hypr/{sig}/.socket2.sock"
        if os.path.exists(candidate):
            return candidate
    base = f"/run/user/{uid}/hypr"
    if os.path.exists(base):
        try:
            for entry in os.listdir(base):
                cand = os.path.join(base, entry, ".socket2.sock")
                if os.path.exists(cand):
                    return cand
        except Exception:
            pass
    return None

last_window_update = 0

def update_window_state(force=False):
    global last_window_update
    now = time.time()
    if not force and (now - last_window_update < 0.1):
        return
    last_window_update = now

    try:
        raw_active = subprocess.check_output(["hyprctl", "activewindow", "-j"], timeout=1)
        raw_clients = subprocess.check_output(["hyprctl", "clients", "-j"], timeout=1)
        active = json.loads(raw_active.decode("utf-8", "ignore"))
        clients = json.loads(raw_clients.decode("utf-8", "ignore"))

        data = {
            "active": active,
            "clients": clients,
            "timestamp": int(now * 1000)
        }

        os.makedirs(os.path.dirname(WINDOWS_FILE), exist_ok=True)
        tmp_file = WINDOWS_FILE + ".tmp"
        with open(tmp_file, "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.replace(tmp_file, WINDOWS_FILE)
    except Exception as e:
        pass

def get_icon_and_category(desc, key, arg):
    d = (desc or "").lower()
    k = (key or "").lower()
    a = (arg or "").lower()

    if any(w in d for w in ["browser", "chrome", "firefox", "brave", "web app", "grok", "whatsapp", "signal", "x post"]):
        return "󰖟", "apps"
    if any(w in d for w in ["terminal", "tmux", "herdr"]):
        return "󰞷", "apps"
    if any(w in d for w in ["file manager", "nautilus", "cwd"]):
        return "󰉋", "apps"
    if any(w in d for w in ["editor", "obsidian", "omawrite", "neovim"]):
        return "󰈮", "apps"
    if any(w in d for w in ["music", "audio", "volume", "sound", "mic"]):
        return "󰕾", "media"
    if any(w in d for w in ["screenshot", "screenrecording", "color picker", "ocr", "extract text"]):
        return "󰹉", "tools"
    if any(w in d for w in ["workspace", "monitor"]):
        return "󱂬", "workspace"
    if any(w in d for w in ["window", "fullscreen", "full width", "split", "float", "group", "pop", "shrink", "expand", "swap"]):
        return "󰉦", "window"
    if any(w in d for w in ["menu", "launcher", "apps menu", "system menu", "theme"]):
        return "󰍜", "system"
    if any(w in d for w in ["lock", "power", "idle", "nightlight", "display", "bluetooth", "wifi", "network", "battery", "bar"]):
        return "󰐥", "system"
    if any(w in d for w in ["scratchpad"]):
        return "󰖮", "workspace"
    if any(w in d for w in ["notification", "dnd", "silenc"]):
        return "󰂛", "system"
    if any(w in d for w in ["copy", "paste", "cut", "clipboard"]):
        return "󰅌", "tools"
    if any(w in d for w in ["calculator", "remind", "passwords", "dictation", "zoom"]):
        return "󰃬", "tools"
    return "󰌌", "other"

def update_keybindings_state():
    try:
        res = subprocess.run(
            ["bash", "-c", "source /usr/share/omarchy/bin/omarchy-menu-keybindings && output_binding_records"],
            capture_output=True, text=True, timeout=8
        )
        lines = [l for l in res.stdout.splitlines() if l.strip()]
        if not lines:
            return

        catalog = []
        seen = set()
        for line in lines:
            parts = line.split("\t")
            header = parts[0]
            key_action = header.split("→")
            key = key_action[0].strip()
            desc = key_action[1].strip() if len(key_action) > 1 else ""
            disp = parts[1].strip() if len(parts) > 1 else ""
            arg = parts[2].strip() if len(parts) > 2 else ""

            combo_id = f"{key}::{desc}"
            if combo_id in seen:
                continue
            seen.add(combo_id)

            action = ""
            if disp == "exec":
                action = arg
            elif disp == "lua":
                action = f"hyprctl dispatch '{arg}'"
            elif disp == "sendshortcut":
                action = f"hyprctl dispatch sendshortcut '{arg}'"
            elif disp:
                action = f"hyprctl dispatch {disp} '{arg}'" if arg else f"hyprctl dispatch {disp}"

            icon, category = get_icon_and_category(desc, key, arg)
            catalog.append({
                "key": key,
                "desc": desc,
                "category": category,
                "icon": icon,
                "action": action,
                "dispatcher": disp,
                "arg": arg
            })

        os.makedirs(os.path.dirname(KEYBINDINGS_FILE), exist_ok=True)
        tmp = KEYBINDINGS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(catalog, f, indent=2)
        os.replace(tmp, KEYBINDINGS_FILE)
    except Exception as e:
        pass

def main():
    lock_fd = acquire_lock()
    last_event_time = {}

    def should_record(event_key, cooldown=0.35):
        now = time.time()
        last = last_event_time.get(event_key, 0)
        if now - last < cooldown:
            return False
        last_event_time[event_key] = now
        return True

    # Immediate snapshot on startup
    update_window_state(force=True)
    update_keybindings_state()

    while True:
        sock_path = get_socket_path()
        if not sock_path:
            time.sleep(2)
            continue

        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(sock_path)
            f = s.makefile("r", encoding="utf-8", errors="ignore")
            print(f"nav-guide: connected to Hyprland socket at {sock_path}", flush=True)

            # Refresh window state upon connecting
            update_window_state(force=True)

            for line in f:
                if not line:
                    break
                line = line.strip()
                if not line or ">>" not in line:
                    continue

                event, data = line.split(">>", 1)

                if event == "workspace":
                    ws = data.split(",")[0].strip()
                    if ws.isdigit() and should_record(f"ws_{ws}", cooldown=0.3):
                        record_action(f"SUPER + {ws}", f"Switch to Workspace {ws}", "󰍹", "workspace")
                    update_window_state()

                elif event == "fullscreen":
                    if should_record("fullscreen", cooldown=0.4):
                        record_action("SUPER + F", "Full Screen", "󰊓", "window")
                    update_window_state()

                elif event == "changefloatingmode":
                    if should_record("float", cooldown=0.4):
                        record_action("SUPER + T", "Toggle Floating Mode", "󰉈", "window")
                    update_window_state()

                elif event == "closewindow":
                    if should_record("close", cooldown=0.3):
                        record_action("SUPER + W", "Close Window", "󰅖", "window")
                    update_window_state()

                elif event == "openwindow":
                    parts = data.split(",", 3)
                    if len(parts) >= 3 and should_record("openwindow", cooldown=0.5):
                        win_class = parts[2].lower()
                        if any(t in win_class for t in ["kitty", "alacritty", "foot", "ghostty", "terminal"]):
                            record_action("SUPER + RETURN", "Launch Terminal", "󰞷", "apps")
                        elif any(b in win_class for b in ["firefox", "chromium", "chrome", "brave", "zen"]):
                            record_action("SUPER + B", "Launch Browser", "󰖟", "web")
                        elif any(m in win_class for m in ["nautilus", "thunar", "filemanager"]):
                            record_action("SUPER + E", "File Manager", "󰉋", "files")
                        elif any(e in win_class for e in ["code", "codium", "cursor", "nvim"]):
                            record_action("SUPER + SHIFT + N", "Launch Editor", "󰅩", "apps")
                    update_window_state()

                elif event == "activewindow" or event == "focusedmon":
                    update_window_state()

                elif event == "movewindow":
                    if should_record("movewindow", cooldown=0.4):
                        record_action("SUPER + SHIFT + Move", "Move / Swap Window", "󰤻", "window")
                    update_window_state()

                elif event == "configreloaded":
                    update_keybindings_state()
                    update_window_state(force=True)

        except Exception as e:
            time.sleep(2)

if __name__ == "__main__":
    main()
